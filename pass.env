# AgentWazuh — Environment Secrets
# DO NOT COMMIT THIS FILE (listed in .gitignore)

# Wazuh Manager REST API (Port 55000)
WAZUH_HOST=192.168.1.234
WAZUH_PORT=55000
WAZUH_API_USER=agentwazuh
WAZUH_API_PASSWORD=1234567890gG@

# OpenSearch/Dashboard (Port 443)
INDEXER_USER=admin
INDEXER_PASSWORD=admin

# SSL Verification
# Set to false for self-signed cert lab environments; true in production
WAZUH_VERIFY_SSL=false

# AgentWazuh Admin Panel Password (default: admin123)
AGENTWAZUH_ADMIN_PASSWORD=admin123
